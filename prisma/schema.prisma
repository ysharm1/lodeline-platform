// Lodeline platform schema. See docs/plan.md §3.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  buyer
  supplier
  admin
}

/// What an organization (or a member acting for it) can do on Lodeline.
/// An organization can be both a buyer and a seller; selling is not built yet.
enum OrgRole {
  buyer
  seller
}

enum Stage {
  mine
  separation
  metal_alloy
  magnet
  component
}

enum Material {
  ndfeb
  smco
  tungsten
  tantalum
  other
}

/// Free-audit result category (see src/services/keyword-classifier.ts).
enum Coverage {
  likely
  possible
  not_likely
}

enum AuditStatus {
  uploaded
  parsing
  classified
  failed
}

enum EvidenceStatus {
  requested
  uploaded
  extracted
  in_review
  accepted
  rejected
}

/// Evidence pack price tier (see src/services/pricing.ts).
enum PackTierLevel {
  starter
  standard
  custom
}

enum PackStatus {
  draft
  pending_payment
  collecting
  generating
  ready
  delivered
}

enum OutreachStatus {
  queued
  sent
  opened
  reminded
  responded
  bounced
}

model Organization {
  id          String            @id @default(uuid())
  name        String
  /// Legacy single-role label (buyer | supplier | operator). Use `roles` for new code.
  kind        String
  /// Capabilities of the organization; can hold both buyer and seller.
  roles       OrgRole[]         @default([buyer])
  country     String?
  createdAt   DateTime          @default(now())
  users       User[]
  memberships Membership[]
  audits    PartsAudit[]
  listings  SupplierListing[]
  packs     EvidencePack[]
}

model User {
  id              String        @id @default(uuid())
  orgId           String?
  org             Organization? @relation(fields: [orgId], references: [id])
  role            Role          @default(buyer)
  email           String        @unique
  name            String?
  emailVerifiedAt DateTime?
  createdAt       DateTime      @default(now())
  sessions        Session[]
  memberships     Membership[]
}

/// A user's membership in an organization, with the roles they hold there.
/// Effective roles = membership.roles ∩ organization.roles (src/services/memberships.ts).
/// User.orgId / User.role remain the active context until multi-org switching ships.
model Membership {
  id         String       @id @default(uuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  roles      OrgRole[]    @default([buyer])
  /// Can manage members and org settings.
  isOrgAdmin Boolean      @default(false)
  createdAt  DateTime     @default(now())

  @@unique([userId, orgId])
  @@index([orgId])
}

/// Copied from LoadEnergy: only the SHA-256 of the token is stored.
model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

model MagicLink {
  id        String    @id @default(uuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

// 1) Free audit
model PartsAudit {
  id              String        @id @default(uuid())
  orgId           String?
  org             Organization? @relation(fields: [orgId], references: [id])
  leadEmail       String
  companyName     String?
  sourceFileKey   String
  sourceFileName  String
  sourceSha256    String
  rowCount        Int
  status          AuditStatus
  llmModel        String?
  promptVersion   String?
  accessTokenHash String?       @unique
  /// Custom-tier quote set by Lodeline staff for an audit larger than Standard.
  /// When set, the buyer can order a Custom pack at this fixed price.
  quotedPriceCents   Int?
  quotedMaxSuppliers Int?
  quotedAt           DateTime?
  quotedById         String?
  createdAt       DateTime      @default(now())
  parts           AuditPart[]
  pack            EvidencePack?
}

model AuditPart {
  id                 String     @id @default(uuid())
  auditId            String
  audit              PartsAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  rowIndex           Int
  partNumber         String?
  description        String
  supplierName       String?
  quantity           Decimal?
  /// Raw columns from the uploaded list, kept so the reason can cite them.
  mpn                String?
  manufacturer       String?
  material           String?
  notes              String?
  materials          Material[]
  coverage           Coverage   @default(not_likely)
  /// Human-readable reason citing the matched rule/pattern and column.
  reason             String     @default("")
  /// rules | table | llm | default
  classifiedBy       String     @default("rules")
  /// Confidence of the final classification (rules or LLM).
  llmConfidence      Float?
  llmRationale       String?
  undocumentedStages Stage[]
  ruleVersion        String

  @@index([auditId])
}

// 2) Evidence pack
model EvidencePack {
  id               String            @id @default(uuid())
  auditId          String            @unique
  audit            PartsAudit        @relation(fields: [auditId], references: [id])
  orgId            String
  status           PackStatus        @default(draft)
  org              Organization      @relation(fields: [orgId], references: [id])
  createdById      String?
  /// Tier chosen from the audit's scope when the pack was ordered.
  tier             PackTierLevel     @default(starter)
  priceCents       Int
  stripeCheckoutId String?
  paidAt           DateTime?
  pdfFileKey       String?
  generatedAt      DateTime?
  /// Set when staff release the reviewed pack to the buyer (status delivered).
  releasedAt       DateTime?
  createdAt        DateTime          @default(now())
  requests         SupplierRequest[]
  refresh          RefreshSubscription?
}

model Supplier {
  id           String            @id @default(uuid())
  name         String
  country      String?
  contactEmail String?
  contactName  String?
  orgId        String?
  requests     SupplierRequest[]
}

/// A request for documents from one supplier. It belongs to EITHER a buyer's
/// evidence pack (packId) OR a supplier-paid verification (verificationId).
model SupplierRequest {
  id              String             @id @default(uuid())
  packId          String?
  pack            EvidencePack?      @relation(fields: [packId], references: [id])
  verificationId  String?
  verification    SupplierVerification? @relation(fields: [verificationId], references: [id], onDelete: Restrict)
  supplierId      String
  supplier        Supplier           @relation(fields: [supplierId], references: [id])
  partIds         String[]
  stagesRequested Stage[]
  tokenHash       String             @unique
  /// AES-256-GCM ciphertext of the raw token so reminders can resend the same link.
  tokenCiphertext String?
  tokenExpiresAt  DateTime
  createdAt       DateTime           @default(now())
  revokedAt       DateTime?
  outreachStatus  OutreachStatus     @default(queued)
  lastEmailAt     DateTime?
  reminderCount   Int                @default(0)
  nextReminderAt  DateTime?
  documents       EvidenceDocument[]
  emails          OutreachEmail[]
  /// Supplier's permission to keep the reviewed documents from this request on
  /// file and reuse them for the supplier's other customers. Null = no consent.
  reuseConsentAt          DateTime?
  /// Name the supplier typed when giving consent.
  reuseConsentName        String?
  /// Set when the supplier withdraws consent; reuse stops from that moment.
  reuseConsentWithdrawnAt DateTime?
  /// Set when a supplier forwarded some of its stages to its own upstream
  /// supplier from the portal; the child request carries those stages.
  parentRequestId String?
  parent          SupplierRequest?  @relation("ForwardedRequests", fields: [parentRequestId], references: [id])
  forwarded       SupplierRequest[] @relation("ForwardedRequests")

  @@index([nextReminderAt])
  @@index([parentRequestId])
  @@index([verificationId])
}

model OutreachEmail {
  id                String          @id @default(uuid())
  requestId         String
  request           SupplierRequest @relation(fields: [requestId], references: [id])
  kind              String // initial | reminder | thanks
  providerMessageId String?
  status            String
  sentAt            DateTime?
  error             String?
}

model EvidenceDocument {
  id              String          @id @default(uuid())
  requestId       String
  request         SupplierRequest @relation(fields: [requestId], references: [id])
  fileKey         String
  fileName        String
  mime            String
  sha256          String
  pageCount       Int?
  status          EvidenceStatus  @default(uploaded)
  rejectionReason String?
  sizeBytes       Int?
  /// Stage the supplier said the document covers (per-stage upload form). A hint for the reviewer, not a claim.
  declaredStage   Stage?
  pages           DocumentPage[]
  textExtracted   Boolean         @default(false)
  uploadedAt      DateTime        @default(now())
  claims          EvidenceClaim[]
}

model EvidenceClaim {
  id              String           @id @default(uuid())
  documentId      String
  document        EvidenceDocument @relation(fields: [documentId], references: [id])
  partId          String?
  issuer          String?
  address         String?
  latitude        Float?
  longitude       Float?
  countryIso      String?
  coveredCountry  Boolean          @default(false)
  coveredReason   String?
  geocodeProvider String?
  issueDate       DateTime?
  expiryDate      DateTime?
  stage           Stage?
  facilityName    String?
  country         String?
  material        Material?
  citations       Json // [{page, quote}] required per field
  llmConfidence   Float?
  /// Deterministic 0..1 score: share of key fields backed by a verbatim quote,
  /// minus penalties (src/services/claim-confidence.ts).
  confidence      Float?
  reviewStatus    EvidenceStatus   @default(in_review)
  reviewedById    String?
  reviewedAt      DateTime?
  reviewerNote    String?
}

/// Append-only (copied from LoadEnergy). No update/delete paths exist in code.
model AuditEntry {
  id                     String   @id @default(uuid())
  action                 String
  actorUserId            String?
  actorSupplierRequestId String?
  subjectId              String
  payload                Json
  ip                     String?
  createdAt              DateTime @default(now())

  @@index([subjectId])
  @@index([createdAt])
}

// 3) Marketplace (P2)
model SupplierListing {
  id                      String        @id @default(uuid())
  orgId                   String?
  org                     Organization? @relation(fields: [orgId], references: [id])
  name                    String
  summary                 String        @default("")
  website                 String?
  city                    String?
  countryIso              String?
  /// Map position for the directory (geocoded from city + country).
  latitude                Float?
  longitude               Float?
  geocodeProvider         String?
  isExample               Boolean       @default(false)
  verifiedFromDocumentIds String[]
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  stages                  Stage[]
  materials               Material[]
  countries               String[]
  verifiedAt              DateTime?
  verifiedFromClaimIds    String[]
  published               Boolean       @default(false)
  referrals               Referral[]
  application             SupplierApplication?
  verifications           SupplierVerification[]
}

enum VerificationStatus {
  pending_payment
  collecting
  complete
  cancelled
}

/// A supplier-paid annual review of the supplier's own upstream evidence.
/// The fee is the same whatever the review finds. Payment never sets
/// SupplierListing.verifiedAt; only DirectoryService.verify does, from
/// accepted evidence.
model SupplierVerification {
  id               String             @id @default(uuid())
  listingId        String
  listing          SupplierListing    @relation(fields: [listingId], references: [id])
  contactEmail     String
  contactName      String?
  facilities       Int
  /// single | multi | network (src/services/pricing.ts)
  tier             String
  priceCents       Int
  status           VerificationStatus @default(pending_payment)
  stripeCheckoutId String?
  checkoutUrl      String?
  paidAt           DateTime?
  /// End of the paid review year.
  periodEndsAt     DateTime?
  completedAt      DateTime?
  completedNote    String?
  createdById      String?
  createdAt        DateTime           @default(now())
  requests         SupplierRequest[]

  @@index([listingId])
}

enum RefreshStatus {
  pending
  active
  cancelled
}

/// A buyer's monthly plan to keep one evidence pack current.
model RefreshSubscription {
  id                   String        @id @default(uuid())
  packId               String        @unique
  pack                 EvidencePack  @relation(fields: [packId], references: [id])
  orgId                String
  tier                 PackTierLevel
  monthlyCents         Int
  intervalDays         Int
  status               RefreshStatus @default(pending)
  stripeCheckoutId     String?
  stripeSubscriptionId String?       @unique
  startedAt            DateTime?
  nextRefreshDueAt     DateTime?
  lastRefreshedAt      DateTime?
  cancelledAt          DateTime?
  createdById          String?
  createdAt            DateTime      @default(now())

  @@index([status, nextRefreshDueAt])
}

model Referral {
  id             String             @id @default(uuid())
  listingId      String
  listing        SupplierListing    @relation(fields: [listingId], references: [id])
  buyerOrgId     String
  status         String // intro | won | lost
  dealValueCents Int?
  commissionBps  Int
  createdAt      DateTime           @default(now())
  invoice        CommissionInvoice?
}

model CommissionInvoice {
  id               String    @id @default(uuid())
  referralId       String    @unique
  referral         Referral  @relation(fields: [referralId], references: [id])
  amountCents      Int
  paymentStatus    String    @default("unpaid")
  paidAt           DateTime?
  stripeTransferId String?
}

model DocumentPage {
  id         String           @id @default(uuid())
  documentId String
  document   EvidenceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  page       Int
  text       String

  @@unique([documentId, page])
}

/// Geocoder results, cached so each address is looked up once per provider.
model GeocodeCache {
  id          String   @id @default(uuid())
  queryHash   String   @unique
  query       String
  provider    String
  found       Boolean
  latitude    Float?
  longitude   Float?
  countryIso  String?
  displayName String?
  createdAt   DateTime @default(now())
}

/// Fixed-window rate-limit counters shared by every app instance.
model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

/// Processed webhook ids (Stripe / email) for idempotency.
model WebhookEvent {
  id         String   @id
  source     String
  receivedAt DateTime @default(now())
}

/// Marketing-site leads: readiness-call requests and checklist downloads.
enum LeadKind {
  readiness_call
  checklist
}

model Lead {
  id         String    @id @default(uuid())
  kind       LeadKind
  name       String?
  company    String
  email      String
  phone      String?
  supplies   String?
  message    String?
  sourcePath String?
  ipHash     String?
  status     String    @default("new") // new | contacted | closed
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([createdAt])
}

enum SupplierApplicationStatus {
  pending
  approved
  rejected
}

/// "For suppliers" applications to be listed as a documented source.
/// Approval creates an unpublished, unverified SupplierListing.
model SupplierApplication {
  id            String                    @id @default(uuid())
  status        SupplierApplicationStatus @default(pending)
  companyName   String
  contactName   String
  email         String
  phone         String?
  website       String?
  city          String?
  countryIso    String?
  stages        Stage[]
  materials     Material[]
  summary       String
  documentsNote String?
  ipHash        String?
  listingId     String?                   @unique
  listing       SupplierListing?          @relation(fields: [listingId], references: [id])
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime                  @default(now())

  @@index([status, createdAt])
}
