# Copy to .env for local dev. Never commit real values.
NODE_ENV=development
# Canonical origin: links in emails, Stripe redirects, sitemap/robots/OG. Production: https://lodeline.org
APP_BASE_URL=http://localhost:3000
# Leave unset for in-memory dev storage; set for Postgres.
# DATABASE_URL=postgresql://lodeline:lodeline@localhost:5432/lodeline
SESSION_SECRET=change-me
# Comma-separated emails that become admin on first magic-link sign-in.
SEED_ADMIN_EMAIL=you@example.com

# Storage (US region). Unset bucket = in-memory (dev only).
S3_DOCS_BUCKET=
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Email: console (dev) | postmark | resend
EMAIL_PROVIDER=console
EMAIL_FROM=Lodeline <info@lodeline.org>
POSTMARK_SERVER_TOKEN=
RESEND_API_KEY=
EMAIL_WEBHOOK_SECRET=

# LLM: the wrapper refuses to run unless ZDR is confirmed. No key = keyword mock.
LLM_ZDR_CONFIRMED=false
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# Stripe (week 2)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Prices (pack tiers, supplier verification, refresh plans) live in src/services/pricing.ts, not here.

# Abuse protection
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_REQUIRED=false
RATE_LIMIT_AUDITS_PER_HOUR=10

CRON_SECRET=
SUPPLIER_TOKEN_TTL_DAYS=30

# --- Week 2 additions ---
# No STRIPE_SECRET_KEY in dev = packs, verifications and refresh plans are marked paid instantly.
# Encrypts supplier-link tokens at rest so reminders can resend the same link (falls back to SESSION_SECRET).
TOKEN_ENCRYPTION_KEY=
# Geocoding: nominatim (default) | mapbox | none
GEOCODER=none
GEOCODER_USER_AGENT=Lodeline/0.2 (info@lodeline.org)
NOMINATIM_BASE_URL=
MAPBOX_TOKEN=
# Dev storage when S3_DOCS_BUCKET is unset
LOCAL_UPLOAD_DIR=.uploads

# --- Marketing site (lodeline.org) ---
# Readiness-call + checklist leads and supplier applications are emailed here.
LEADS_NOTIFY_EMAIL=info@lodeline.org
# Inline booking in the contact section (empty string = form only).
CALENDLY_URL=https://calendly.com/lodeline-info/30min
RATE_LIMIT_LEADS_PER_HOUR=5
