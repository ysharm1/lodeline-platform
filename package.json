{
  "name": "lodeline-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Lodeline: rare-earth / critical-mineral supply-chain documentation and analysis.",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate-deploy": "prisma migrate deploy",
    "db:start": "node scripts/dev-db.mjs",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/s3-request-presigner": "3.1149.0",
    "@prisma/client": "6.19.3",
    "@react-pdf/renderer": "4.9.0",
    "exceljs": "4.4.0",
    "leaflet": "1.9.4",
    "next": "15.5.27",
    "papaparse": "5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stripe": "23.0.0",
    "unpdf": "1.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.20.4",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "16.14.0-beta.17",
    "postcss": "8.5.30",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
